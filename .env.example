# CalCritters environment variables
# Copy this file to ".env.local" and fill in the values you need.
# Everything here is optional: with no keys set, the app runs in demo mode and
# critters reply with scripted, in-character lines.

# Powers live, model-driven critter conversations.
# Get a key at https://console.anthropic.com/ . Never commit your real key.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for chat. Defaults to claude-opus-4-8.
# CALCRITTERS_MODEL=claude-opus-4-8

# Optional: only needed if you wire up the database-backed progress tracking
# described in supabase/schema.sql. The app works fully without these.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
